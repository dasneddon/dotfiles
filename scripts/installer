#!/usr/bin/env bash

#Package Bundle
BUNDLE=(fastfetch rsync git vim tmux gh)


# Detect package manager
if command -v apt-get &>/dev/null; then
    PKG_MANAGER="apt"
elif command -v dnf &>/dev/null; then
    PKG_MANAGER="dnf"
elif command -v zypper &>/dev/null; then
    PKG_MANAGER="zypper"
elif command -v pacman &>/dev/null; then
    PKG_MANAGER="pacman"
elif command -v brew &>/dev/null; then
    PKG_MANAGER="brew"
else
    echo "Unsupported package manager" >&2
    exit 1
fi

# Install packages
case "$PKG_MANAGER" in
    apt)
        if ! apt-cache show fastfetch &/dev/null; then
            if [[ "$ID" == "ubuntu" || "$ID_LIKE" == *ubuntu* ]]; then
                sudo apt-get install -y software-properties-common
                sudo add-apt-repository ppa:zhangsongcui3371/fastfetch
                sudo apt-get update
            fi
        fi
        sudo apt-get update
        sudo apt-get install -y "${BUNDLE[@]}"
        bash linux-installer.sh
        ;;
    dnf)
        sudo dnf makecache
        sudo dnf install -y "${BUNDLE[@]}"
        bash linux-installer.sh
        ;;
    zypper)
        sudo zypper refresh
        sudo zypper install -y "${BUNDLE[@]}"
        bash linux-installer.sh
        ;;
    pacman)
        sudo pacman -Syu --needed "${BUNDLE[@]}"
        bash linux-installer.sh
        ;;
    brew)
        brew update
        brew install "${BUNDLE[@]}"
        bash mac-installer.sh
        ;;
    *)
        echo "Unsupported package manager: $PKG_MANAGER" >&2
        exit 1
        ;;
esac
